# =============================================================================
# Sürüm sabitlemesi (pin). ADR-0001 Consequences #2: sürümler sabitlenir.
#
# !!! İLK KURULUMDAN ÖNCE DOĞRULAYIN !!!
# Bu değerler yazıldığı andaki kararlı sürümlerdir. Kurulum öncesi
# `helm search repo <chart> --versions` ile teyit edin ve gerekiyorsa
# güncelleyin. Sürüm yükseltmesi = ayrı bir PR.
# =============================================================================

# Gateway API CRD'leri (Cilium'dan ÖNCE kurulur)
GATEWAY_API_VERSION="v1.2.1"
GATEWAY_API_CHANNEL="standard"          # standard | experimental

# Cilium
CILIUM_CHART_VERSION="1.16.5"
CILIUM_HELM_REPO="https://helm.cilium.io/"

# MetalLB
METALLB_CHART_VERSION="0.14.9"
METALLB_HELM_REPO="https://metallb.github.io/metallb"

# Rook-Ceph
ROOK_CHART_VERSION="v1.15.6"
ROOK_HELM_REPO="https://charts.rook.io/release"

# Harbor
HARBOR_CHART_VERSION="1.16.0"           # Harbor 2.12.x
HARBOR_HELM_REPO="https://helm.goharbor.io"

# Keycloak
# NOT: Bitnami imaj dağıtım politikası değişti (bkz. underlay/README.md,
# "Bilinen riskler"). İç mirror kullanıyorsanız KEYCLOAK_IMAGE_REGISTRY set edin.
KEYCLOAK_CHART_VERSION="24.4.7"
KEYCLOAK_HELM_REPO="https://charts.bitnami.com/bitnami"
KEYCLOAK_IMAGE_REGISTRY=""              # boş = chart varsayılanı

# --- Faz 2: Control plane çalışma zamanları ---------------------------------

# ArgoCD
ARGOCD_CHART_VERSION="7.8.2"            # ArgoCD 2.13.x
ARGOCD_HELM_REPO="https://argoproj.github.io/argo-helm"

# Crossplane v2
# KRİTİK DÜZELTME (Faz 11): önceki pin "1.18.0" idi ama bu, GERÇEK bir
# kind cluster'ında test edilene kadar hiç fark edilmemiş bir sürüm
# uyumsuzluğu taşıyordu — 1.18.0'ın CompositeResourceDefinition v1
# reconciler'ı, bu repo'nun compositions'larının ürettiği NAMESPACED
# kaynaklar (Role/RoleBinding/ResourceQuota vb.) için `resourceRefs[].
# namespace` alanını yazmaya çalışır ama üretilen CRD şeması bu alanı
# TANIMLAMAZ — sonuç: HER XTenant/XPostgreSQLInstance reconcile'ı "field
# not declared in schema" hatasıyla KALICI OLARAK başarısız olurdu. Gerçek
# Crossplane 2.x (major sürüm, "Crossplane v2" adının GERÇEK karşılığı —
# 1.18.0 aslında ESKİ 1.x serisinin SON sürümüydü, "v2" adı yalnızca bu
# repo'nun ADR'sindeki kavramsal isimlendirmeydi) bunu çözüyor. Bkz.
# `tests/e2e/kind-chain/README.md` ve PLATFORM_CONTEXT.md Faz 11 günlüğü.
CROSSPLANE_CHART_VERSION="2.4.0"
CROSSPLANE_HELM_REPO="https://charts.crossplane.io/stable"

# Crossplane provider'lar (OCI paket referansları — Helm chart değil)
PROVIDER_KUBERNETES_VERSION="v0.15.0"
PROVIDER_KUBERNETES_IMAGE="xpkg.upbound.io/crossplane-contrib/provider-kubernetes"

# DÜZELTME (Faz 12b): v0.20.0 registry'de HİÇ VAR OLMAMIŞ (MANIFEST_UNKNOWN) —
# Faz 2'den beri yanlıştı, provider paketleri hiç GERÇEKTEN kurulmadığı için
# fark edilmemişti. Gerçek sürümler: v0.20.3, v0.20.4, v0.21.0, v1.x.
# v0.20.4 Crossplane 2.4.0 ile CANLI test edildi → Installed+Healthy.
PROVIDER_HELM_VERSION="v0.20.4"
PROVIDER_HELM_IMAGE="xpkg.upbound.io/crossplane-contrib/provider-helm"

PROVIDER_TERRAFORM_VERSION="v0.19.0"
PROVIDER_TERRAFORM_IMAGE="xpkg.upbound.io/upbound/provider-terraform"

FUNCTION_KCL_VERSION="v0.10.0"
FUNCTION_KCL_IMAGE="xpkg.upbound.io/crossplane-contrib/function-kcl"

# function-auto-ready — composition pipeline'ının İKİNCİ adımı (Faz 12b'de
# eksik olduğu fark edildi; bkz. crossplane/resources/functions.yaml)
#
# DÜZELTME (Faz 12b, GERÇEK kind cluster'ında keşfedildi): v0.5.0,
# ConfigMap/Job/Namespace/ServiceAccount/Secret vb. YAYGIN Kubernetes
# tiplerini "ready" olarak işaretleyen healthchecks registry'sinden
# YOKSUNDU (bu registry crossplane-contrib/function-auto-ready v0.6.0'da
# eklendi — bkz. PR #160). Sonuç: HİÇBİR composed kaynak (native "Ready"
# status condition'ı olan cert-manager Issuer/Certificate DIŞINDA) HİÇBİR
# ZAMAN ready işaretlenmiyordu — XTenant.status HER ZAMAN Ready=False
# kalıyordu (Synced=True olsa BİLE). v0.7.0'a yükseltildi (en son sürüm,
# canlı test edildi).
FUNCTION_AUTO_READY_VERSION="v0.7.0"
FUNCTION_AUTO_READY_IMAGE="xpkg.upbound.io/crossplane-contrib/function-auto-ready"

# Kyverno
KYVERNO_CHART_VERSION="3.3.6"
KYVERNO_HELM_REPO="https://kyverno.github.io/kyverno"

# External Secrets Operator
ESO_CHART_VERSION="0.10.7"
ESO_HELM_REPO="https://charts.external-secrets.io"

# --- Faz 3: PKI ---------------------------------------------------------------

# Vault (HashiCorp resmi chart)
VAULT_CHART_VERSION="0.29.1"            # Vault 1.18.x
VAULT_HELM_REPO="https://helm.releases.hashicorp.com"
VAULT_APP_VERSION="1.18.1"

# cert-manager (Jetstack)
CERT_MANAGER_CHART_VERSION="v1.16.2"
CERT_MANAGER_HELM_REPO="https://charts.jetstack.io"

# --- Faz 8: Backstage + ApplicationSet -----------------------------------

# Backstage (resmi Helm chart)
BACKSTAGE_CHART_VERSION="2.6.1"
BACKSTAGE_HELM_REPO="https://backstage.github.io/charts"

# --- Faz 9: Gözlemlenebilirlik + OpenCost -------------------------------------

# kube-prometheus-stack (Prometheus + Alertmanager + Grafana + exporters)
KUBE_PROMETHEUS_STACK_CHART_VERSION="65.5.1"
KUBE_PROMETHEUS_STACK_HELM_REPO="https://prometheus-community.github.io/helm-charts"

# Loki (log depolama — Rook-Ceph RGW/S3 backend)
LOKI_CHART_VERSION="6.16.0"
LOKI_HELM_REPO="https://grafana.github.io/helm-charts"

# Tempo (trace depolama — Rook-Ceph RGW/S3 backend)
TEMPO_CHART_VERSION="1.10.3"
TEMPO_HELM_REPO="https://grafana.github.io/helm-charts"

# OpenCost
OPENCOST_CHART_VERSION="1.39.0"
OPENCOST_HELM_REPO="https://opencost.github.io/opencost-helm-chart"

# --- Faz 12h: CNPG operatörü + Velero (code review #11'in çözümü) -------------
# ÖNCEDEN yalnızca tests/e2e/kind-chain/run.sh'te (SÜRÜMÜ SABİTLENMEMİŞ olarak)
# kuruluyordu — üretim bootstrap/Application setinde hiç karşılığı yoktu.

# CloudNativePG operatörü (tenant Postgres composition'ının BEKLEDİĞİ operatör)
CNPG_CHART_VERSION="0.22.1"
CNPG_HELM_REPO="https://cloudnative-pg.github.io/charts"

# Velero (K8s obje + PV yedekleme — Ceph RGW birincil hedef, isteğe bağlı
# küme-dışı ikincil hedef; bkz. control-plane/velero/README.md)
VELERO_CHART_VERSION="7.2.1"
VELERO_HELM_REPO="https://vmware-tanzu.github.io/helm-charts"
