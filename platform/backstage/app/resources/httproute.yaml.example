apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: backstage
  namespace: backstage
spec:
  parentRefs:
    - name: platform-gateway
      namespace: kube-system
      sectionName: https
  hostnames: [backstage.example.internal]
  rules:
    - backendRefs:
        - name: backstage
          port: 7007
